# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# NextAuth.js v4 — JWT session encryption secret.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# Guest API key for unauthenticated policy access (must match backend GUEST_API_KEY)
NEXT_PUBLIC_GUEST_API_KEY=your_guest_api_key_min_16_chars

# --- App Branding & Configuration (Optional) ---
# NEXT_PUBLIC_APP_NAME="Blih Brain"
