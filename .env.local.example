# Public URL of this app. Required for NextAuth.
# In local development, defaults to http://localhost:3000. In production, set to your deployment domain.
NEXTAUTH_URL=http://localhost:3000

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# NextAuth.js v4 — JWT session encryption secret.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# Guest API key for unauthenticated policy access (must match backend GUEST_API_KEY)
NEXT_PUBLIC_GUEST_API_KEY=your_guest_api_key_min_16_chars

